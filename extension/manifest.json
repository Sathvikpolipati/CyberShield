{
  "manifest_version": 3,
  "name": "CyberShield | Network Packet Monitor",
  "version": "1.0.0",
  "description": "Real-time network security monitor, packet inspector, and threat detection extension.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CyberShield Monitor"
  },
  "background": {
    "service_worker": "background.js"
  }
}
